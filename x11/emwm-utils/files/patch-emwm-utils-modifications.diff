diff --color -Nru emwm-utils/mf/Makefile.Linux emwm-utils.NEW/mf/Makefile.Linux
--- emwm-utils/mf/Makefile.Linux	2026-09-19 14:34:18
+++ emwm-utils.NEW/mf/Makefile.Linux	2026-09-19 12:09:40
@@ -1,22 +1,22 @@
 # Installation prefix. Typically /usr or /usr/local.
-PREFIX = /usr
+PREFIX = /opt/local
 MANDIR = $(PREFIX)/share/man
 
 # X11 configuration directory.
 # On recent Linuxen it's usually either /etc/X11, /usr/share/X11
 # or less likely /usr/lib/X11. Some symlink them one way or another.
-RCDIR = /etc/X11
+RCDIR = $(PREFIX)/etc/X11
 
 # Default application resources directory.
 # By convention located in the X11 configuration directory. 
 APPLRESDIR = $(RCDIR)/app-defaults
 
 # Usually nothing needs to be changed beyond this point
-INCDIRS = -I/usr/local/include
-LIBDIRS = -L/usr/local/lib
+INCDIRS = -I/usr/local/include -I/opt/local/include -I/opt/X11/include
+LIBDIRS = -L/usr/local/lib -L/opt/local/lib -L/opt/X11/lib
 
 CFLAGS = -O0 -g -Wall -DPREFIX='"$(PREFIX)"' $(INCDIRS)
-SYSLIBS = -lcrypt
+#SYSLIBS = -lcrypt
 
 include common.mf
 
